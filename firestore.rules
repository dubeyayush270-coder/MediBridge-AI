rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // MediBridge AI - Strict Zero-Trust Client Database Security Rules
    // -------------------------------------------------------------------------
    // To protect sensitive elderly patient medical data, all direct browser SDK
    // reads and writes are strictly DENIED.
    //
    // All profile management, clinical records, medications, appointments,
    // and adherence logging are mediated exclusively through server-side Next.js
    // API routes authenticated with Firebase ID tokens and executed via the
    // Firebase Admin SDK.
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
