# ========================================================
# MediBridge AI - Environment Configuration Template
# Catalyst 2026 PromptWars Solo Hackathon
# ========================================================

# Firebase Client Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Firebase Admin SDK Configuration (Server-side Protected)
# In Google Cloud Run, these are automatically inferred from the attached service account
# if GOOGLE_APPLICATION_CREDENTIALS or K_SERVICE is active.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Cloud Run / Application Server Settings
PORT=8080
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Gemini API Key (For Phase 2 AI Visit Companion & OCR extraction)
GEMINI_API_KEY=your-gemini-api-key

# Email Notification Provider (For scheduled reminder processing)
EMAIL_PROVIDER_API_KEY=your-email-provider-key
NOTIFICATION_FROM_EMAIL=care-reminders@medibridge.ai
